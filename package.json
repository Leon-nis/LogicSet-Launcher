{
  "name": "logicset-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop launcher for LogicSet modded Torchlight II multiplayer.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run optimize:assets && electron-vite dev",
    "build": "npm run optimize:assets && npm run check:assets && npm run typecheck && electron-vite build",
    "check:assets": "node scripts/check-assets.mjs",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --build --pretty"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "posthog-node": "^5.37.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^39.2.7",
    "electron-vite": "^4.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=20.20.0"
  }
}
